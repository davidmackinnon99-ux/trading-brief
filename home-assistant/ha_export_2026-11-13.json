    "id": "1790068519452",
    "alias": "Flop Room Curtain",
    "description": "Flop Room curtain. Before 5:30 pm (checked every 5 min): closes fully if the Kitchen AC reads above 26 °C and the sun is in the north-facing sector, and the curtain is not already closed, then notifies. At 5:30 pm: if the curtain is below 90% open, sets it to 90% open and notifies; otherwise does nothing. Paused while Curtain Manual Override is on.",
    "triggers": [
      {
        "trigger": "time_pattern",
        "minutes": "/5",
        "id": "daytime_check"
      },
      {
        "trigger": "time",
        "at": "17:30:00",
        "id": "evening"
      },
      {
        "trigger": "webhook",
        "webhook_id": "8d531d88-c861-4de5-a6a3-79f79483472c",
        "allowed_methods": [
          "POST",
          "PUT"
        ],
        "local_only": false,
        "id": "controller"
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "input_boolean.curtain_manual_override",
        "state": "off"
      }
    ],
    "actions": [
      {
        "choose": [
          {
            "conditions": [
              {
                "condition": "trigger",
                "id": "evening"
              },
              {
                "condition": "template",
                "value_template": "{{ states('cover.aqara_roller_shade_driver_e1') not in ['unavailable', 'unknown'] and state_attr('cover.aqara_roller_shade_driver_e1', 'current_position') | int(90) < 90 }}"
              }
            ],
            "sequence": [
              {
                "action": "cover.set_cover_position",
                "target": {
                  "entity_id": "cover.aqara_roller_shade_driver_e1"
                },
                "data": {
                  "position": 90
                }
              },
              {
                "action": "notify.mobile_app_davids_iphone_17",
                "data": {
                  "title": "Flop Room Curtain",
                  "message": "Flop Room Curtain set to 90% open at 5:30 pm."
                }
              }
            ]
          },
          {
            "conditions": [
              {
                "condition": "time",
                "before": "17:30:00"
              },
              {
                "condition": "template",
                "value_template": "{{ state_attr('climate.kitchen_kitchen', 'current_temperature') | float(-999) > 26 }}"
              },
              {
                "condition": "template",
                "value_template": "{% set az = state_attr('sun.sun', 'azimuth') | float(-999) %} {{ az <= 20 or az >= 330 }}"
              },
              {
                "condition": "template",
                "value_template": "{{ states('cover.aqara_roller_shade_driver_e1') not in ['unavailable', 'unknown'] and state_attr('cover.aqara_roller_shade_driver_e1', 'current_position') | int(0) > 0 }}"
              }
            ],
            "sequence": [
              {
                "action": "cover.close_cover",
                "target": {
                  "entity_id": "cover.aqara_roller_shade_driver_e1"
                }
              },
              {
                "action": "notify.mobile_app_davids_iphone_17",
                "data": {
                  "title": "Flop Room Curtain",
                  "message": "Flop Room Curtain closed because Kitchen AC exceeded 26 C AND sun azimuth was in the north-facing sector."
                }
              }
            ]
          }
        ]
      }
    ],
    "mode": "queued",
    "max": 3
  },
  "helpers_2026_11_13": {
    "template_sensors": [
      {
        "entity": "sensor.kitchen_ac_power",
