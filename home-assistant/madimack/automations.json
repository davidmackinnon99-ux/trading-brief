[
  {
    "id": "1788609036147",
    "alias": "Clamp Madimack Pool Target Temp",
    "description": "Hard cap at 40C (device max) - app setting governs freely below that",
    "triggers": [
      {
        "entity_id": "climate.spa_madimack_inverter_pool_heat_pump",
        "attribute": "temperature",
        "trigger": "state"
      }
    ],
    "conditions": [
      {
        "condition": "template",
        "value_template": "{{ state_attr('climate.spa_madimack_inverter_pool_heat_pump', 'temperature') | float(0) > 40 }}"
      }
    ],
    "actions": [
      {
        "target": {
          "entity_id": "climate.spa_madimack_inverter_pool_heat_pump"
        },
        "data": {
          "temperature": 40
        },
        "action": "climate.set_temperature"
      }
    ],
    "mode": "single"
  },
  {
    "id": "1791071253875",
    "alias": "Madimack - Recover Tuya Local Connection",
    "description": "Reload only the Madimack Tuya Local entry after its climate entity remains unavailable or unknown for 10 minutes.",
    "triggers": [
      {
        "trigger": "template",
        "value_template": "{{ states('climate.spa_madimack_inverter_pool_heat_pump') in ['unavailable', 'unknown'] }}",
        "for": "00:10:00"
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "input_boolean.madimack_overnight_isolation",
        "state": "off"
      }
    ],
    "actions": [
      {
        "action": "homeassistant.reload_config_entry",
        "target": {
          "entity_id": "climate.spa_madimack_inverter_pool_heat_pump"
        }
      }
    ],
    "mode": "single"
  },
  {
    "id": "1791114104211",
    "alias": "Madimack - Overnight isolation start",
    "description": "Diagnostic test: after the 11pm pool shutdown, disable the Tuya Local Madimack entry so HA is silent overnight. Skipped if the pump is not confirmed off (e.g. manual override).",
    "triggers": [
      {
        "trigger": "time",
        "at": "23:05:00"
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "climate.spa_madimack_inverter_pool_heat_pump",
        "state": "off"
      }
    ],
    "actions": [
      {
        "action": "input_boolean.turn_on",
        "target": {
          "entity_id": "input_boolean.madimack_overnight_isolation"
        }
      },
      {
        "action": "homeassistant.disable_config_entry",
        "data": {
          "config_entry_id": "01M0S444MRTZGQNRQV7KVKVV1A"
        }
      }
    ],
    "mode": "single"
  },
  {
    "id": "1791114104247",
    "alias": "Madimack - Overnight isolation end",
    "description": "Re-enable the Tuya Local Madimack entry at sunrise (or after an HA restart in daylight) and confirm it reconnects.",
    "triggers": [
      {
        "trigger": "sun",
        "event": "sunrise",
        "id": "sunrise"
      },
      {
        "trigger": "homeassistant",
        "event": "start",
        "id": "start"
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "input_boolean.madimack_overnight_isolation",
        "state": "on"
      },
      {
        "condition": "or",
        "conditions": [
          {
            "condition": "trigger",
            "id": "sunrise"
          },
          {
            "condition": "state",
            "entity_id": "sun.sun",
            "state": "above_horizon"
          }
        ]
      }
    ],
    "actions": [
      {
        "action": "homeassistant.enable_config_entry",
        "data": {
          "config_entry_id": "01M0S444MRTZGQNRQV7KVKVV1A"
        }
      },
      {
        "wait_template": "{{ states('climate.spa_madimack_inverter_pool_heat_pump') not in ['unavailable','unknown'] }}",
        "timeout": "00:15:00",
        "continue_on_timeout": true
      },
      {
        "if": [
          {
            "condition": "template",
            "value_template": "{{ not wait.completed }}"
          }
        ],
        "then": [
          {
            "action": "notify.mobile_app_davids_iphone_17",
            "data": {
              "title": "Madimack",
              "message": "Didn't reconnect within 15 min of sunrise re-enable. Tuya cloud: {{ states('climate.spa_inverter_pool_heat_pump_madimack_pool_heater') }}",
              "data": {
                "push": {
                  "interruption-level": "time-sensitive"
                }
              }
            }
          }
        ]
      },
      {
        "action": "input_boolean.turn_off",
        "target": {
          "entity_id": "input_boolean.madimack_overnight_isolation"
        }
      }
    ],
    "mode": "single"
  },
  {
    "id": "1791114104288",
    "alias": "Madimack - Alert offline",
    "description": "Priority alert at 10 min unavailable; second alert at 20 min if recovery reload failed. Silent during overnight isolation.",
    "triggers": [
      {
        "trigger": "template",
        "value_template": "{{ states('climate.spa_madimack_inverter_pool_heat_pump') in ['unavailable','unknown'] }}",
        "for": "00:10:00",
        "id": "ten"
      },
      {
        "trigger": "template",
        "value_template": "{{ states('climate.spa_madimack_inverter_pool_heat_pump') in ['unavailable','unknown'] }}",
        "for": "00:20:00",
        "id": "twenty"
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "input_boolean.madimack_overnight_isolation",
        "state": "off"
      }
    ],
    "actions": [
      {
        "action": "notify.mobile_app_davids_iphone_17",
        "data": {
          "title": "Madimack offline",
          "message": "{{ 'Offline 10 min - recovery reload running.' if trigger.id=='ten' else 'Still offline after 20 min - recovery reload FAILED.' }} Tuya cloud: {{ states('climate.spa_inverter_pool_heat_pump_madimack_pool_heater') }}",
          "data": {
            "push": {
              "interruption-level": "time-sensitive"
            }
          }
        }
      }
    ],
    "mode": "queued"
  },
  {
    "id": "1791114104319",
    "alias": "Madimack - Alert recovered",
    "description": "Report recovery and outage duration after an outage of 10+ min.",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "climate.spa_madimack_inverter_pool_heat_pump",
        "from": [
          "unavailable",
          "unknown"
        ]
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "input_boolean.madimack_overnight_isolation",
        "state": "off"
      },
      {
        "condition": "template",
        "value_template": "{{ trigger.to_state.state not in ['unavailable','unknown'] and (now() - trigger.from_state.last_changed).total_seconds() >= 600 }}"
      }
    ],
    "actions": [
      {
        "action": "notify.mobile_app_davids_iphone_17",
        "data": {
          "title": "Madimack recovered",
          "message": "Back after {{ ((now() - trigger.from_state.last_changed).total_seconds()/60)|round(0)|int }} min. Tuya cloud: {{ states('climate.spa_inverter_pool_heat_pump_madimack_pool_heater') }}"
        }
      }
    ],
    "mode": "queued"
  },
  {
    "id": "1791114104349",
    "alias": "Madimack - Tuya cloud offline",
    "description": "Diagnostic: report when Tuya cloud loses the pump and whether HA local was silent at the time.",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "climate.spa_inverter_pool_heat_pump_madimack_pool_heater",
        "to": "unavailable",
        "for": "00:05:00"
      }
    ],
    "conditions": [],
    "actions": [
      {
        "action": "notify.mobile_app_davids_iphone_17",
        "data": {
          "title": "Madimack cloud offline",
          "message": "Tuya cloud lost the pump. Overnight isolation: {{ states('input_boolean.madimack_overnight_isolation') }}. Local: {{ states('climate.spa_madimack_inverter_pool_heat_pump') }}"
        }
      }
    ],
    "mode": "single"
  }
]